{
  "packageRules": [
    {
      "packageName": "bazzite",
      "fileMatch": [
        "^Containerfile$"
      ],
      "datasource": "docker",
      "versioning": "semver",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ublue-os/bazzite-gnome-nvidia"],
      "matchDepTypes": ["docker-arg"],
      "versioning": "loose"
    }
  ]
}

    {
      "fileMatch": [
        ".service$"
      ],
      "regex": "([a-z0-9]+/[a-z0-9]+):(\\\\d+\\\\.\\\\d+\\\\.\\\\d+)",
      "versioning": "semver",
      "schedule": [
        "before 9am on thursday"
      ]
    }
  ]
}
