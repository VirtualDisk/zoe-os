{
  "packageRules": [
    {
      "packageName": "bazzite",
      "fileMatch": [
        "^Containerfile$"
      ],
      "datasource": "docker",
      "versioning": "semver",
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "fileMatch": [
        ".service$"
      ],
      "regex": "([a-z0-9]+/[a-z0-9]+):(\\\\d+\\\\.\\\\d+\\\\.\\\\d+)",
      "versioning": "semver",
      "schedule": [
        "before 9am on thursday"
      ]
    }
  ]
}
